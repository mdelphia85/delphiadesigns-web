# Configure these in Vercel > Project > Settings > Environment Variables.
# Keep credentials server-side; never prefix the API key with NEXT_PUBLIC_.
RESEND_API_KEY=
# Recipient for contact-form inquiries. By default this is delphiadesigns@gmail.com.
CONTACT_EMAIL=delphiadesigns@gmail.com
# Sender must belong to a domain verified in Resend.
CONTACT_FROM_EMAIL="Delphia Designs <contact@delphiadesignsco.com>"
